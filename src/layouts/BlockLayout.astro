---
const {
  class: className = "",
  id = "",
  padding = "py-6 px-8",
  width = "w-full",
  maxWidth = "",
  centered = true,
} = Astro.props;
---

<div
  class:list={[
    "block",
    padding,
    width,
    maxWidth,
    centered && "mx-auto",
    className,
  ]}
  id={id}
>
  <slot />
</div>

<style>
  .block {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
  }
</style>