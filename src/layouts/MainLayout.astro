---
const { class: className = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/astro_website/favicon.svg" />
		<link rel="icon" href="/astro_website/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class:list={ ["main-layout", className]}>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
	}
</style>
