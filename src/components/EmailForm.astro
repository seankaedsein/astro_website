---
const { class: className = "" } = Astro.props;
---

<div class:list={["w-full rounded-xl bg-white p-10 shadow-xl", className]}>
  <form action="https://api.web3forms.com/submit" method="POST" class="space-y-8">
    <input type="hidden" name="access_key" value="2206bbe6-f1f2-4818-8567-fe04b913d4c1" />
    <input type="hidden" name="subject" value="New query from the website" />
    <input type="hidden" name="from_name" value="Website Contact Form" />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none;" />

    <h2 class="text-5xl font-semibold text-gray-900">
      Submit a query
    </h2>

    <div>
      <label
        for="name"
        class="mb-3 block text-2xl font-medium text-gray-800"
      >
        Name
      </label>

      <input
        id="name"
        type="text"
        placeholder="Enter your name"
        name="name"
        required
        class="w-full rounded-lg border border-gray-300 px-6 py-5 text-2xl"
      />
    </div>

    <div>
      <label
        for="email"
        class="mb-3 block text-2xl font-medium text-gray-800"
      >
        Email
      </label>

      <input
        id="email"
        type="email"
        placeholder="Enter your email"
        name="email"
        required
        class="w-full rounded-lg border border-gray-300 px-6 py-5 text-2xl"
      />
    </div>

    <div>
      <label
        for="query"
        class="mb-3 block text-2xl font-medium text-gray-800"
      >
        Query
      </label>

      <textarea
        id="query"
        placeholder="Enter your query"
        name="query"
        required
        rows="7"
        class="w-full rounded-lg border border-gray-300 px-6 py-5 text-2xl"
      ></textarea>
    </div>

    <button
      type="submit"
      class="w-full rounded-lg bg-[#3b5d4a] px-6 py-5 text-2xl font-medium text-white transition hover:opacity-90"
    >
      Submit
    </button>
  </form>
</div>