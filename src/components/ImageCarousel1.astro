---
import type { ImageMetadata } from "astro";

interface Props {
  backgroundColor?: string;
  images: ImageMetadata[];
}

const { backgroundColor, images } = Astro.props;
const galleryLength = images.length;
---

<div
  class="flex items-center gap-4"
  style={`background-color: ${backgroundColor || "transparent"}`}
>
  <button type="button" data-carousel-left class="border px-3 py-2">
    &lt;
  </button>

  <div class="relative w-full overflow-hidden">
    <div
      data-carousel-track
      class="flex transition-transform duration-300 ease-in-out"
      style="transform: translateX(0%);"
    >
      {images.map((image, index) => (
        <div class="w-full shrink-0">
          <img
            src={image.src}
            alt={`Slide ${index + 1}`}
            class="block h-auto w-full"
          />
        </div>
      ))}
    </div>
  </div>

  <button type="button" data-carousel-right class="border px-3 py-2">
    &gt;
  </button>
</div>

<script define:vars={{ galleryLength }}>
  const root = document.currentScript?.previousElementSibling;
  const leftBtn = root?.querySelector("[data-carousel-left]");
  const rightBtn = root?.querySelector("[data-carousel-right]");
  const track = root?.querySelector("[data-carousel-track]");

  let currentIndex = 0;

  function updateCarousel() {
    if (!track) return;
    track.style.transform = `translateX(-${currentIndex * 100}%)`;
  }

  leftBtn?.addEventListener("click", () => {
    currentIndex = (currentIndex - 1 + galleryLength) % galleryLength;
    updateCarousel();
  });

  rightBtn?.addEventListener("click", () => {
    currentIndex = (currentIndex + 1) % galleryLength;
    updateCarousel();
  });
</script>