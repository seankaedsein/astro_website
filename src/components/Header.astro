---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const {
  src = logo,
  alt = "Company Logo",
  width = 50,
  height = 30,
  class: className = "",
  ...rest
} = Astro.props;

const baseHeaderClass =
  "site-header sticky top-0 z-50 w-full transition-transform duration-200 ease-out";
---

<header id="site-header" class:list={[baseHeaderClass, className]}>
  <!-- Background layer -->
  <div class="bg-gradient-to-r from-emerald-950 via-emerald-900 to-lime-800 text-white border-b border-white/10 backdrop-blur supports-[backdrop-filter]:bg-emerald-950/70">
    <nav class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between gap-4">
      <!-- Brand -->
      <a href="#section_start" class="flex items-center gap-3 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60">
        <Image
          src={src}
          layout="constrained"
          alt={alt}
          width={width}
          height={height}
          {...rest}
        />
        <span class="sr-only">Home</span>
      </a>

      <!-- Links -->
      <div class="flex items-center gap-2 text-sm">
        <a
          href="#section_start"
          class="px-3 py-2 rounded-md hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
        >
          Home
        </a>

        <span aria-hidden="true" class="hidden sm:inline text-white/40">|</span>

        <a
          href="#section_about"
          class="px-3 py-2 rounded-md hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
        >
          About Us
        </a>

        <span aria-hidden="true" class="hidden sm:inline text-white/40">|</span>

        <a
          href="#section_contact"
          class="px-3 py-2 rounded-md hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
        >
          Contact Us
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Only keep what's truly custom: the hide/show transform */
  .site-header {
    transform: translateY(0);
    will-change: transform;
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
</style>

<script is:inline>
  const header = document.getElementById("site-header");
  if (!header) console.warn("Header element not found");

  let lastY = window.scrollY;
  let ticking = false;

  const threshold = 8; // ignore tiny scroll jitter
  const topLock = 40;   // always show at top

  function update() {
    ticking = false;

    const y = window.scrollY;
    const delta = y - lastY;

    // Always show when near the top
    if (y <= topLock) {
      header.classList.remove("is-hidden");
      lastY = y;
      return;
    }

    // Ignore small movements (trackpads cause noise)
    if (Math.abs(delta) < threshold) return;

    if (delta > 0) header.classList.add("is-hidden");     // down -> hide
    else header.classList.remove("is-hidden");            // up -> show

    lastY = y;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true }
  );
</script>