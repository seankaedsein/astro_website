---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const {
  src = logo,
  alt = "Company Logo",
  width = 50,
  height = 30,
  class: className = "",
  ...rest
} = Astro.props;

const baseHeaderClass =
  "sticky top-0 z-50 w-full";
---

<header id="site-header" class:list={[baseHeaderClass, className]}>
  <!-- Background layer -->
  <div class="backdrop-blur-xs bg-white/10 mix-blend-exclusion">
    <nav class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between gap-4">
      <!-- Brand -->
      <a href="#section_start" class="flex items-center gap-3 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60">
        <Image
          src={src}
          layout="constrained"
          alt={alt}
          width={width}
          height={height}
          {...rest}
        />
        <span class="sr-only">Home</span>
      </a>

      <!-- Links -->
      <div class="flex items-center gap-2 text-sm">
        <a
          href="#section_home"
          class="px-3 py-2 rounded-md text-gray-300 hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60 mix-blend-exclusion"
        >
          Home
        </a>

        <span aria-hidden="true" class="hidden sm:inline text-white/40">|</span>

        <a
          href="#section_about"
          class="px-3 py-2 rounded-md text-gray-300 hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
        >
          About Us
        </a>

        <span aria-hidden="true" class="hidden sm:inline text-white/40">|</span>

        <a
          href="#section_contact"
          class="px-3 py-2 rounded-md text-gray-300 hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
        >
          Contact Us
        </a>
      </div>
    </nav>
  </div>
</header>
