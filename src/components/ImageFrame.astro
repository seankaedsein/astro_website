---
import { Image } from "astro:assets";

const {
  src,
  alt,
  width,
  height,
  class: className,
  ...rest
} = Astro.props;
---

<figure class:list={["image-frame", className]}>
  <Image src={src} layout="constrained" alt={alt} width={width} height={height} {...rest} />
  <slot name="caption" />
</figure>

<style>
  .image-frame { mix-blend-mode: hard-light; }
</style>