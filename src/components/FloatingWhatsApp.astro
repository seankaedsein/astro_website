---
import whatsapp_icon from "../assets/images/whatsapp_icon.png";

const {
  phone = "60167852982",
  message = "Hello, I am interested in the land listing.",
} = Astro.props;

const whatsappUrl =
  `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contact via WhatsApp"
  class="fixed bottom-8 right-8 z-50 flex h-18 w-18 items-center justify-center rounded-full bg-[#25D366] shadow-2xl transition hover:scale-105 hover:bg-[#1ebe5d]"
>
  <img
    src={whatsapp_icon.src}
    alt="WhatsApp"
    class="h-10 w-10"
  />
</a>